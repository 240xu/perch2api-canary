# Perch2API configuration. Every value has a working default, so an empty file is
# valid. Copy to `.env` (gitignored); real environment variables win over the file.

# -- Listen -------------------------------------------------------------------
HOST=127.0.0.1
PORT=8801

# Bearer key clients must send. Empty = no auth (loopback only).
PERCH2API_KEY=change-me

# -- Upstream -----------------------------------------------------------------
PERCH_APP_URL=https://app.perchai.app
# Must equal the installed perchai-cli package version, or be empty (the
# User-Agent then degrades to "unknown", which real clients also emit). Reporting
# a version that is not installed is one of the reasons Perch gave for the ban.
PERCH_CLI_VERSION=2.4.130
PERCH_LOCALE=en
PERCH_CLIENT_SURFACE=cli

# -- Session discovery --------------------------------------------------------
# Explicit files win over discovered profiles. The CLI profile under $HOME is
# read-only under the unit's ProtectHome=read-only, so point this at a writable
# copy: token refreshes are persisted back to this file.
PERCH_SESSION_FILES=/opt/perch2api/accounts/main.json
# PERCH_CLI_AUTH_DIR=/opt/perch2api/accounts

# -- Prompt shaping -----------------------------------------------------------
# canary | canary-merge | canary-scrub | full | full-agents | off
# canary          gate paragraph alone, caller system kept as its own message
# canary-merge    gate paragraph + caller system in one message
# canary-scrub    same, with third-party agent self-names rewritten
# full            whole Ask-build operator prompt (27,815 chars)
# full-agents     whole Agents-build operator prompt (51,887 chars)
# off             no injected text (control arm)
PERCH_PROMPT_MODE=canary
# Rewrite "You are <other agent>" self-names. Only used by canary-scrub.
PERCH_SCRUB_IDENTITY=1
# Append the per-turn date/context block to the first user message.
PERCH_TURN_CONTEXT=1

# -- Envelope dialect ---------------------------------------------------------
# honeypot = the eight top-level keys of the captured official call (default)
# magpie   = adds resendAfterOutput / roostReasoning / effort / manualModelOptionId
PERCH_ENVELOPE_MODE=honeypot
PERCH_SEND_MANUAL_OPTION=0
PERCH_SEND_ROOST_EXTRAS=0

# -- Guards -------------------------------------------------------------------
PERCH_MAX_CONCURRENCY=1
PERCH_MIN_INTERVAL_MS=1000
PERCH_BREAKER_THRESHOLD=5
PERCH_BAN_CHECK=1
PERCH_USAGE_PREFLIGHT=1
# off | best-effort | required — tickets are not required by the surface, and
# minting one spends the same rate budget as the model call.
PERCH_TICKET_MODE=off

# -- Developer panel ----------------------------------------------------------
# Loopback only. Reach it with: ssh -L 8802:127.0.0.1:8802 <host>
PERCH_PANEL=1
PERCH_PANEL_HOST=127.0.0.1
PERCH_PANEL_PORT=8802
# Switches changed in the panel are persisted here and override .env.
PERCH_RUNTIME_FILE=/opt/perch2api/runtime.json

# -- Behaviour ----------------------------------------------------------------
PERCH_TIMEOUT_MS=300000
PERCH_HEARTBEAT_MS=10000
PERCH_MAX_RETRIES=2
PERCH_EXPOSE_REASONING=true
PERCH_DISABLE_THINKING=false
PERCH2API_LOG=true
# PERCH_DEBUG_WIRE=1

# -- Legacy (only consulted by the `full` prompt modes) -----------------------
# prepend | verbatim | verbatim-append | off
# PERCH_SYSTEM_PREFIX_MODE=verbatim
# The full prompt is read from .perch-prefix.txt (or this variable).
# PERCH_SYSTEM_PREFIX=You are ...
# PERCH_PROMPT_AGENTS_FILE=/opt/perch2api/.perch-prompt-agents.txt
